  "intent": "SIMULATED. Full assistant message, reasoning summary and opaque encrypted_content survive the next request unchanged; synthetic placeholder is not a valid service signature.",
  "parameters": {
    "prompt": {
      "type": "string",
      "default": "Draw one blue cup on a white background."
    },
    "model": {
      "type": "string",
      "default": "sim-ark-text-v1"
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
        "headers": {
          "accept": "application/json",
          "authorization": "Bearer SIMULATOR_ONLY_NOT_A_REAL_KEY",
          "content-type": "application/json"
        },
        "body": {
          "model": {
            "$parameter": "model"
          },
          "messages": [
            {
              "role": "user",
              "content": {
                "$parameter": "prompt"
              }
            }
          ],
          "stream": false
        }
      },
      "response": {
        "status": 200,
        "json": {
          "id": "SIMULATED-ark-encrypted-1",
          "object": "chat.completion",
          "created": 1793262360,
          "model": {
            "$parameter": "model"
          },
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "SIMULATED first turn.",
                "reasoning_content": "SIMULATED reasoning summary.",
                "encrypted_content": "SIMULATED_OPAQUE_ENCRYPTED_CONTENT_DO_NOT_REWRITE"
              },
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 10,
            "completion_tokens": 5,
            "total_tokens": 15
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
        "headers": {
          "accept": "application/json",
          "authorization": "Bearer SIMULATOR_ONLY_NOT_A_REAL_KEY",
          "content-type": "application/json"
        },
        "body": {
          "model": {
