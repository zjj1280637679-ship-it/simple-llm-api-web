  "intent": "SIMULATED. Local transport injection only; delay/hang require an explicit scheduler. Abort preserves signal.reason; not a claim of server cancellation.",
  "parameters": {
    "prompt": {
      "type": "string",
      "default": "Draw one blue cup on a white background."
    },
    "model": {
      "type": "string",
      "default": "sim-ark-text-v1"
