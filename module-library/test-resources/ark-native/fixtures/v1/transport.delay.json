          "stream": false
        }
      },
      "response": {
        "status": 200,
        "json": {
          "id": "SIMULATED-ark-text-ok-1",
          "object": "chat.completion",
          "created": 1793262360,
          "model": {
            "$parameter": "model"
          },
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Host Ark text reply."
              },
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 10,
            "completion_tokens": 5,
            "total_tokens": 15
          }
        },
        "delayMs": 250
