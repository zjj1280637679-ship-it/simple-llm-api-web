  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "url": "https://ark.cn-beijing.volces.com/api/v3/chat/completions",
        "headers": {
          "accept": "application/json",
          "authorization": "Bearer SIMULATOR_ONLY_NOT_A_REAL_KEY",
          "content-type": "application/json"
        },
        "body": {
          "model": {
            "$parameter": "model"
          },
          "messages": [
            {
              "role": "user",
